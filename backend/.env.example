PORT=3000
DATABASE_URL=postgresql://payflow:payflow_dev_password@localhost:5432/payflow_ai

# watsonx.ai credentials - get these from your IBM Cloud / watsonx.ai account
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# watsonx.ai deployment space ID (required - the text/chat API needs a
# space_id or project_id with an associated WML instance; a deployment
# space is the more reliable way to bind one, see docs/watson-orchestrate.md)
WATSONX_SPACE_ID=your_deployment_space_id_here

# Optional - kept for reference, not currently used by the chat API call
WATSONX_PROJECT_ID=your_project_id_here
